{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "statements",
        "no_statements"
      ]
    },
    "annotations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "evidence_text": {
            "type": "string"
          },
          "evidence_occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "concept_id": {
            "type": "string",
            "enum": [
              "capitalizacion_individual",
              "propiedad_individual_fondos",
              "reciprocidad_contributiva",
              "control_responsabilidad_individual",
              "actitud",
              "identidad",
              "necesidad_material",
              "igualdad_universalismo",
              "conciencia_costos",
              "solidaridad_previsional_colectiva",
              "solidaridad_intergeneracional",
              "libertad_eleccion_previsional",
              "ineficiencia_estado",
              "prevision_como_mercado",
              "ilegitimidad_origen_dictatorial",
              "acuerdos_moderacion"
            ]
          },
          "stance": {
            "type": "string",
            "enum": [
              "support",
              "oppose"
            ]
          },
          "justification": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "evidence_text",
          "evidence_occurrence",
          "concept_id",
          "stance",
          "justification",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vote",
          "procedural",
          "too_short",
          "truncated",
          "insufficient_context",
          "segmentation_problem"
        ]
      }
    },
    "decision_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [
    "decision",
    "annotations",
    "quality_flags",
    "decision_confidence"
  ],
  "additionalProperties": false
}
