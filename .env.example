# Clasificación común para análisis, hipótesis y muestreo manual.
# Todo partido observado debe estar enumerado. Los no enumerados quedan como
# unclassified para impedir que una variante nueva se impute silenciosamente a centro.
OPENAI_API_KEY=TUAPI
