# Clasificación común para análisis, hipótesis y muestreo manual.
# Todo partido observado debe estar enumerado. Los no enumerados quedan como
# unclassified para impedir que una variante nueva se impute silenciosamente a centro.
OPENAI_API_KEY=TUAPI
PARTY_ALIGNMENT='{"left":["Federación Regionalista Verde Social","Partido Comunista de Chile","Partido Comunes","Partido Convergencia Social","Partido Ecologista Verde de Chile","Partido Frente Amplio","Partido Humanista","Partido Liberal de Chile","Partido Por la Democracia","Partido Radical Socialdemócrata","Partido Radical Social Demócrata","Partido Socialista de Chile","País Progresista","Revolución Democrática"],"center":["Movimiento Amarillos Por Chile","Partido Demócrata Cristiano","Partido Democratas Chile"],"right":["Partido Evolución Política","Partido Nacional","Partido Nacional Libertario","Partido Renovación Nacional","Partido Republicano De Chile","Partido Social Cristiano","Partido Unión Demócrata Independiente"],"nonpartisan":["Independiente","Partido De La Gente"]}'
# Categoría específica para H1b: partidos de la antigua Concertación
# más el Partido Liberal, incorporado por su pertenencia posterior
# a coaliciones de centroizquierda.
CENTER_LEFT_PARTIES='["Partido Liberal de Chile","Partido Por la Democracia","Partido Radical Socialdemócrata","Partido Radical Social Demócrata","Partido Socialista de Chile", "Partido Demócrata Cristiano"]'
# Modelo y reintentos transitorios para nuevas ejecuciones de anotación LLM.
# El número indica reintentos después del intento inicial y está limitado a 0..4
# (cinco intentos totales). Un incomplete por tokens duplica el límite base hasta
# el techo de fallback configurado aquí.
ANNOTATIONS_MODEL=gpt-5.6-luna
ANNOTATIONS_MAX_RETRIES=4
ANNOTATIONS_INCOMPLETE_MAX_OUTPUT_TOKENS=65536
